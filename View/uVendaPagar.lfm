  object qryCRBoleto: TZQuery
    Connection = Dados.Conexao
    SQL.Strings = (
      'select'
      'cr.*,'
      'pessoa.razao,'
      'pessoa.cnpj,'
      'pessoa.endereco,'
      'pessoa.numero,'
      'pessoa.cnpj,'
      'pessoa.bairro,'
      'pessoa.uf,'
      'pessoa.municipio,'
      'pessoa.cep,'
      'pessoa.complemento,'
      'pessoa.email1'
      'from CRECEBER CR'
      'left join pessoa on pessoa.codigo=cr.fkcliente'
      'where'
      'cr.fk_venda=:id and cr.cartao=:cartao')
    Left = 400
    Top = 208
    Params = <
      item
        Name = 'ID'
        DataType = ftInteger
        ParamType = ptInput
      end
      item
        Name = 'CARTAO'
        DataType = ftString
        ParamType = ptInput
        Size = 1
      end>
    object qryCRBoletoEMAIL1: TStringField
      FieldName = 'EMAIL1'
      ProviderFlags = []
      ReadOnly = True
      Size = 60
    end
  end
