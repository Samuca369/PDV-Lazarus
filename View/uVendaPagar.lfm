  object qryCarne: TZQuery
    AfterPost = qryCRAfterPost
    Connection = Dados.Conexao
    SQL.Strings = (
      'select CR.*, pe.razao, ve.nome as vendedor from creceber CR'
      'left join pessoa pe on pe.codigo = cr.fkcliente'
      'left join vendedores ve on ve.codigo = cr.id_vendedor'
      'where'
      'cr.fk_venda=:id and cr.cartao=:cartao'
      '')
    Left = 456
    Top = 158
