<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="PDV"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="rxnew"/>
      </Item>
      <Item>
        <PackageName Value="ACBrDiversos"/>
      </Item>
      <Item>
        <PackageName Value="ACBrSerial"/>
      </Item>
      <Item>
        <PackageName Value="ACBr_TEFD"/>
      </Item>
      <Item>
        <PackageName Value="ACBrDFeComum"/>
      </Item>
      <Item>
        <PackageName Value="ACBr_NFe"/>
      </Item>
      <Item>
        <PackageName Value="ACBr_NFe_DanfeESCPOS"/>
      </Item>
      <Item>
        <PackageName Value="ACBr_NFe_DanfeRL"/>
      </Item>
      <Item>
        <PackageName Value="laz_synapse"/>
      </Item>
      <Item>
        <PackageName Value="ACBr_Boleto"/>
      </Item>
      <Item>
        <PackageName Value="ACBr_SAT"/>
      </Item>
      <Item>
        <PackageName Value="PCNComum"/>
      </Item>
      <Item>
        <PackageName Value="ACBrComum"/>
      </Item>
      <Item>
        <PackageName Value="zcomponent"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="PDV.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\Serial.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\uEnums.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\uLib.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\uLib02.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\Model\Udados.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="Dados"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="DataModule"/>
      </Unit>
      <Unit>
        <Filename Value="..\Model\uDadosWeb.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DadosWeb"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="DataModule"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\uRotinasComuns.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DMRotinas"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="DataModule"/>
      </Unit>
      <Unit>
        <Filename Value="..\Model\uDmPDV.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="dmPDV"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="DataModule"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\frExibeMensagem.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FormExibeMensagem"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\ufrmStatus.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmStatus"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\uConexaoBD.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmConexaoBD"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="uSplash.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmSplash"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="..\View\uChave.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmChave"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="..\bin\PDV"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="..\pendentes;..\Model;..\View"/>
      <UnitOutputDirectory Value="..\lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <SyntaxMode Value="Delphi"/>
      </SyntaxOptions>
    </Parsing>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
        <UseLineInfoUnit Value="True"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
